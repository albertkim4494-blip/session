# Copy to .env.local and fill in. Only VITE_-prefixed vars are exposed to the app.

# Supabase project (cloud sync + auth)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# RevenueCat public Android SDK key (goog_…) for in-app billing on the native
# Android shell. Public key — safe to ship in the app. Leave empty to disable
# billing (web builds and dev without a native shell don't need it).
VITE_REVENUECAT_ANDROID_KEY=
